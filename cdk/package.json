{
  "name": "cdk",
  "version": "0.1.0",
  "bin": {
    "cdk": "bin/cdk.js"
  },
  "scripts": {
    "clean": "rm -rf cdk.out",
    "bootstrap": "cdk bootstrap aws://277328279708/eu-central-1 --profile=shirtsupplier --app 'node --import tsx bin/app.ts'",
    "synth": "cdk synth --app 'node --import tsx bin/app.ts' --quiet",
    "__________ Deploy _______________": "",
    "deploy:data-lake:production": "cdk deploy Production-ConsentStorage-DataLake       --app 'node --import tsx bin/app.ts' --require-approval never",
    "__________ Destroy _______________": "",
    "destroy:data-lake:production": "cdk destroy Production-ConsentStorage-DataLake       --app 'node --import tsx bin/app.ts' --force"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "^2.1117.0",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.236.0",
    "constructs": "^10.0.0"
  }
}
